{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/lifelike-synthetic-data-generator/schema-config.schema.json",
  "title": "Synthetic Data Generator Config",
  "type": "object",
  "required": [
    "records"
  ],
  "properties": {
    "sql_schema": {
      "$ref": "#/$defs/sqlSchema"
    },
    "version": {
      "type": "string",
      "description": "Optional config version. Preferred value is 1.0."
    },
    "locale": {
      "type": "string",
      "description": "Faker locale such as en_US or nl_BE."
    },
    "seed": {
      "type": "integer",
      "description": "Optional deterministic seed."
    },
    "records": {
      "type": "integer",
      "minimum": 1
    },
    "population_model": {
      "$ref": "#/$defs/populationModel"
    },
    "output": {
      "type": "object",
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "csv",
            "json",
            "ndjson",
            "sql",
            "html",
            "markdown"
          ]
        },
        "path": {
          "type": "string"
        },
        "table_name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "include_sensitive_fields": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "output_format": {
      "type": "string",
      "enum": [
        "csv",
        "json",
        "ndjson",
        "sql",
        "html",
        "markdown"
      ],
      "description": "Legacy key. Prefer output.format."
    },
    "output_file": {
      "type": "string",
      "description": "Legacy key. Prefer output.path."
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/field"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "field": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "populationDimension": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "represented": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "populationSegment": {
      "type": "object",
      "required": [
        "weight",
        "values"
      ],
      "properties": {
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "label": {
          "type": "string"
        },
        "source": {
          "type": "object"
        },
        "values": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "populationModel": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "object"
        },
        "filters": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            ]
          }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/populationDimension"
          }
        },
        "source_query": {
          "$ref": "#/$defs/sourceQuery"
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/populationSegment"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "segments"
          ]
        },
        {
          "required": [
            "source_query"
          ]
        }
      ],
      "additionalProperties": false
    },
    "sourceQueryFilter": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "value"
          ],
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "eq",
                "neq",
                "gt",
                "gte",
                "lt",
                "lte",
                "in"
              ]
            },
            "value": {}
          },
          "additionalProperties": false
        }
      ]
    },
    "sourceQuery": {
      "type": "object",
      "required": [
        "dataset",
        "dimension_columns"
      ],
      "properties": {
        "catalog_id": {
          "type": "string",
          "minLength": 1
        },
        "base_url": {
          "type": "string",
          "minLength": 1
        },
        "dataset": {
          "type": "string",
          "minLength": 1
        },
        "weight_column": {
          "type": "string",
          "minLength": 1
        },
        "timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "dimension_columns": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "dimension_value_maps": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        },
        "filters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sourceQueryFilter"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "catalog_id"
          ]
        },
        {
          "required": [
            "base_url"
          ]
        }
      ],
      "additionalProperties": false
    }
  },
  "anyOf": [
    {
      "required": [
        "fields"
      ]
    },
    {
      "required": [
        "sql_schema"
      ]
    }
  ]
}
    "sqlSchema": {
      "type": "object",
      "properties": {
        "ddl": {
          "type": "string",
          "minLength": 1
        },
        "ddl_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "ddl"
          ]
        },
        {
          "required": [
            "ddl_path"
          ]
        }
      ],
      "additionalProperties": false
    },
