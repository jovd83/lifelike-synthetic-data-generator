{
  "version": "2.2",
  "selection_guidance": {
    "primary_rule": "For population-representative datasets, prefer official statistics that directly match the requested geography and dimensions.",
    "token_efficiency_rule": "Only source and model the dimensions the user explicitly needs represented.",
    "address_rule": "Use address datasets to shape formats and locality vocabularies, not to claim population representativeness unless population weights are also applied.",
    "reporting_rule": "Always state which dimensions are distribution-backed and which remain merely lifelike.",
    "monitoring_rule": "Use references/open_data_monitoring.json plus scripts/check_open_data_updates.py to detect newly public datasets or schema drift, and scripts/refresh_open_data_monitoring.py to refresh the stored baseline."
  },
  "sources": [
    {
      "id": "statbel-open-data-api",
      "name": "Statbel Open Data API",
      "url": "https://opendata-api.statbel.fgov.be",
      "locale_scope": [
        "BE"
      ],
      "fit_for_representativeness": "primary",
      "access": {
        "protocols": [
          "REST",
          "PostgREST",
          "JSON",
          "CSV"
        ],
        "discovery_endpoints": [
          "https://opendata-api.statbel.fgov.be",
          "https://opendata-api.statbel.fgov.be/rpc/get_tables_columns",
          "https://opendata-api.statbel.fgov.be/rpc/get_tables_columns_grouped"
        ],
        "table_prefix": "tf_"
      },
      "monitoring_reference": "references/open_data_monitoring.json",
      "update_check_command": "python scripts/check_open_data_updates.py --source-id statbel-open-data-api",
      "recommended_for": [
        "age distribution",
        "sex distribution",
        "NUTS3 geography",
        "nationality",
        "country of birth",
        "employment and unemployment mix",
        "education mix",
        "income quantiles",
        "occupation status"
      ],
      "limitations": [
        "The current public API is strongest for Belgium-wide and regional distributions, not raw person-level microdata.",
        "Healthcare expenditure is macro-level context, not a direct individual health-status distribution.",
        "Postal-code or street-level density requires additional geographic files or grids."
      ],
      "datasets": [
        {
          "id": "tf_hvd_demo_population",
          "path": "/tf_hvd_demo_population",
          "best_for": [
            "age",
            "sex",
            "population spread by NUTS3",
            "nationality",
            "country of birth"
          ],
          "columns": [
            "CD_YEAR",
            "CD_SEX",
            "CD_AGE",
            "CD_CNTRY_BTH",
            "CD_NATLTY",
            "CD_NUTS_LVL3",
            "CD_PROPERTY",
            "MS_VALUE"
          ],
          "query_example": "https://opendata-api.statbel.fgov.be/tf_hvd_demo_population?CD_YEAR=eq.2023&CD_NUTS_LVL3=eq.BE100&CD_CNTRY_BTH=eq.TOTAL&CD_NATLTY=eq.TOTAL&CD_PROPERTY=eq.MS_POP&select=CD_SEX,CD_AGE,MS_VALUE"
        },
        {
          "id": "tf_hvd_lfs_employment",
          "path": "/tf_hvd_lfs_employment",
          "best_for": [
            "employment mix",
            "education by labour-market segment",
            "regional labour-market distributions"
          ],
          "columns": [
            "CD_YEAR",
            "CD_SEX",
            "CD_EMPMT_AGE",
            "CD_NUTS_LVL2",
            "CD_ISCED_2011",
            "CD_PROPERTY",
            "MS_VALUE"
          ]
        },
        {
          "id": "tf_hvd_lfs_unemployment",
          "path": "/tf_hvd_lfs_unemployment",
          "best_for": [
            "unemployment mix",
            "age by sex by education distributions",
            "regional labour-market distributions"
          ],
          "columns": [
            "CD_YEAR",
            "CD_SEX",
            "CD_EMPMT_AGE",
            "CD_NUTS_LVL2",
            "CD_ISCED_2011",
            "CD_PROPERTY",
            "MS_VALUE"
          ]
        },
        {
          "id": "tf_hvd_silc_poverty",
          "path": "/tf_hvd_silc_poverty",
          "best_for": [
            "income quantiles",
            "occupation status",
            "education level",
            "regional social conditions"
          ],
          "columns": [
            "CD_YEAR",
            "CD_SEX",
            "CD_PVRTY_AGE",
            "CD_ISCED_2011",
            "CD_PVRTY_OCPTN_STS",
            "CD_PVRTY_INCM_QNTL",
            "CD_NUTS_LVL2",
            "CD_PROPERTY",
            "MS_VALUE"
          ],
          "query_example": "https://opendata-api.statbel.fgov.be/tf_hvd_silc_poverty?CD_YEAR=eq.2023&CD_SEX=neq.TOTAL&CD_PVRTY_AGE=neq.TOTAL&CD_PROPERTY=eq.MS_RISK_OF_POVERTY&select=CD_SEX,CD_PVRTY_AGE,CD_ISCED_2011,CD_PVRTY_OCPTN_STS,CD_PVRTY_INCM_QNTL,CD_NUTS_LVL2,MS_VALUE"
        },
        {
          "id": "tf_hvd_silc_inequality",
          "path": "/tf_hvd_silc_inequality",
          "best_for": [
            "inequality context",
            "age by sex inequality splits"
          ],
          "columns": [
            "CD_YEAR",
            "CD_SEX",
            "CD_INEQ_AGE",
            "CD_PROPERTY",
            "MS_VALUE"
          ]
        },
        {
          "id": "tf_hvd_healthcare_expenditure",
          "path": "/tf_hvd_healthcare_expenditure",
          "best_for": [
            "macro health-spending context"
          ],
          "columns": [
            "TIME_PERIOD",
            "HC",
            "HF",
            "HP",
            "FS",
            "OBS_VALUE"
          ],
          "fit_for_individual_health_status": "weak"
        }
      ]
    },
